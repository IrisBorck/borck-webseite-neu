---
import Layout from '../layouts/ApartmentLayout.astro';
import Header from '../components/ApartmentHeader.astro';
import Footer from '../components/ApartmentFooter.astro';
import Dialogs from '../components/ApartmentDialogs.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { apartments } from '../data/home';
import imageAlts from '../data/apartment-image-alts.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const outdoor: Record<string,string> = {
  saphir:'Terrasse mit Gartenblick', rubin:'Terrasse mit Gartenblick',
  opal:'2 Balkone · einer mit seitlichem Deichblick', tuerkis:'Kleiner Balkon mit Deichblick',
  topas:'Kleiner Balkon · seitlicher Deich- und Meerblick', bernstein:'Terrasse mit Gartenblick',
  smaragd:'Balkon mit seitlichem Deichblick',
};
---
<Layout title="Apartments · Haus Aquamarin in Büsum" bookingEnabled={true}>
<a class="skip-link" href="#inhalt">Zum Hauptinhalt springen</a>
<div class="preview-banner">Neue Website · Vorschau <span>— Live-Suche über Smoobu</span></div>
<Header />
<main id="inhalt" class="sand directory-page">
<section class="directory-intro container" aria-labelledby="directory-title">
<p class="eyebrow">Sieben Apartments · ein Stück Nordsee</p>
<h1 id="directory-title">Finde deinen Lieblingsplatz.</h1>
<p class="intro-copy">Zu zweit, mit Familie oder mit Hund: Vergleiche unsere Apartments und finde deine Auszeit in Büsum – ca. 400 m von der Familienlagune entfernt.</p>
<section class="travel-search" aria-labelledby="travel-title">
<div class="search-heading"><h2 id="travel-title">Preis &amp; Verfügbarkeit</h2><span>Direkt bei Iris</span></div>
<form id="directory-search">
<div class="field"><label for="travel-arrival">Anreise</label><input id="travel-arrival" type="date" name="arrival" required /></div>
<div class="field"><label for="travel-departure">Abreise</label><input id="travel-departure" type="date" name="departure" required /></div>
<div class="field"><label for="travel-guests">Personenzahl</label><select id="travel-guests" name="guests">{[1,2,3,4,5].map(n=><option value={n} selected={n===2}>{n} {n===1?'Person':'Personen'}</option>)}</select></div>
<button class="button" type="submit">Preise &amp; Verfügbarkeit prüfen <Icon name="arrow" /></button>
</form>
<div class="search-foot"><p id="travel-status" role="status">Wähle deinen Reisezeitraum und die Personenzahl.</p><button type="button" id="clear-search">Auswahl löschen</button></div>
<p class="search-note">Die Suche öffnet aktuelle Angebote von Smoobu hier auf der Seite. Dabei werden deine Reisedaten und technische Verbindungsdaten an Smoobu übermittelt.</p>
<noscript><p>Für die Suche bitte JavaScript aktivieren oder <a href="https://booking.smoobu.com/9A40536">direkt bei Smoobu suchen</a>.</p></noscript>
</section>
<section id="live-results" class="live-results" tabindex="-1" aria-labelledby="results-title" hidden>
<div class="results-heading"><p class="eyebrow">Dein Wunschaufenthalt</p><h2 id="results-title">Aktuelle Angebote</h2><p id="search-summary"></p></div>
<p>Hier zeigt dir Smoobu die verfügbaren Apartments und die Preise für deinen Aufenthalt. Die Apartmentübersicht mit unseren Detailseiten findest du direkt darunter.</p>
<p class="cost-note">Kurabgabe wird separat abgerechnet. Optionale Leistungen kommen nach Auswahl hinzu. Bei weniger als 5 Nächten fällt einmalig ein Kurzreisezuschlag von 85 € an; prüfe, ob er im angezeigten Preis enthalten ist.</p>
<p id="provider-status" role="status" class="search-note"></p>
<div class="provider-frame"><iframe id="directory-booking" title="Live-Preise und Verfügbarkeit aller Apartments bei Smoobu" height="700" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
<p class="search-note"><a id="search-fallback" href="https://booking.smoobu.com/9A40536" target="_blank" rel="noopener noreferrer">Suche mit diesen Reisedaten in einem eigenen Fenster öffnen <span aria-hidden="true">↗</span></a></p>
<p class="search-note">Änderst du die Reisedaten im Smoobu-Fenster, übernimm sie bitte auch oben in unsere Suche, damit die Apartmentlinks dieselben Angaben behalten.</p>
</section>
</section>
<section class="directory-list container" aria-labelledby="selection-title">
<div class="selection-heading"><h2 id="selection-title">Unsere Apartments im Vergleich</h2><span>28 bis ca. 76 m² · für 1–5 Personen</span></div>
<p class="overview-note">Aktuelle Preise und freie Termine stehen nach deiner Suche im Smoobu-Suchfenster. Die Karten sind eine Übersicht aller sieben Apartments.</p>
<div class="directory-cards">
{apartments.map((a,index) => <article class="directory-card" id={a.id} data-directory-apartment={a.id} data-guests={a.guests} aria-labelledby={`name-${a.id}`}>
<div class="directory-photo"><Photo stem={a.image} alt={imageAlts[a.id as keyof typeof imageAlts]} eager={index===0} sizes="(max-width: 650px) 100vw, (max-width: 1000px) 38vw, 400px" /></div>
<div class="directory-copy"><h3 id={`name-${a.id}`}>{a.name}</h3><ul class="directory-facts" aria-label={`Kernmerkmale von ${a.name}`}><li>{a.size}</li><li>bis {a.guests} Personen</li><li>{a.sleeping}</li></ul><p class="outdoor"><Icon name="arrow" />{outdoor[a.id]}</p>{a.id==='smaragd' && <p class="access-note">Zugang über eine offene Stahltreppe.</p>}</div>
<div class="directory-action"><p data-card-status>Preis &amp; Verfügbarkeit nach Reisedatum</p><a class="button" data-travel-link href={a.id==='saphir'?`${base}/apartments/saphir/`:`https://www.nordsee-buesum-fewo.de/${a.id}`} aria-label={`${a.name}: Ansehen & buchen`}>Ansehen &amp; buchen <Icon name="arrow" /></a>{a.id!=='saphir' && <span class="destination-note">Detailseite auf unserer bestehenden Website</span>}</div>
</article>)}
</div>
<p class="directory-help">Du bist unsicher, welches Apartment zu dir passt? <a href="tel:+491727952082">Ruf Iris an: 0172 7952082</a>.</p>
</section>
</main>
<Footer /><Dialogs directorySearch={true} />
<script src="../scripts/apartment-shell.ts"></script>
<script src="../scripts/directory-search.ts"></script>
</Layout>
<style>
.directory-page{padding-bottom:64px}.directory-intro{padding-top:48px}.directory-intro h1{max-width:820px}.intro-copy{font-size:20px;line-height:1.55;margin-top:20px;max-width:760px}.travel-search{background:white;border:1px solid var(--line);border-radius:18px;padding:26px 28px;margin-top:32px;box-shadow:0 8px 28px rgba(30,55,90,.04)}.search-heading,.selection-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16px}.search-heading h2{font-size:24px;color:var(--navy)}.search-heading span,.selection-heading>span{font-size:14px}.search-heading{margin-bottom:20px}#directory-search{display:grid;grid-template-columns:1fr 1fr .8fr 1.5fr;gap:16px;align-items:end}#directory-search .button{min-height:52px;padding-inline:16px;font-size:14px}#directory-search .field input{max-width:100%;appearance:none;-webkit-appearance:none}.search-foot{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-top:14px;font-size:14px}.search-foot button{padding:4px 0;text-decoration:underline;text-underline-offset:4px;flex-shrink:0}.search-note{font-size:13px;line-height:1.5;margin-top:12px;max-width:none}.live-results{background:var(--aqua);border:1px solid var(--line);border-radius:18px;padding:28px;margin-top:24px;scroll-margin-top:120px}.results-heading{margin-bottom:16px}.results-heading .eyebrow{margin-bottom:7px}.results-heading h2{font-size:27px;color:var(--navy);margin-bottom:10px}.cost-note{font-size:14px}.provider-frame{margin-block:18px;background:white;border-radius:12px}.provider-frame iframe{display:block;width:100%;border:0;min-height:400px;border-radius:12px}.directory-list{margin-top:48px}.selection-heading h2{font-size:25px;color:var(--navy)}.overview-note{font-size:14px;margin:12px 0 22px;max-width:none}.directory-cards{display:grid;gap:20px}.directory-card{display:grid;grid-template-columns:34% minmax(0,1fr) 244px;background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden}.directory-photo{min-width:0;min-height:230px;height:100%}.directory-photo :global(img){width:100%;height:100%;object-fit:cover;aspect-ratio:1.5}.directory-copy{padding:26px 24px;align-self:center;min-width:0}.directory-copy h3{font-size:27px;overflow-wrap:anywhere}.directory-facts{display:flex;flex-wrap:wrap;list-style:none;gap:3px 16px;padding:0;margin:12px 0 14px;font-size:16px}.directory-facts li{position:relative}.directory-facts li:not(:last-child):after{content:'·';position:absolute;right:-10px}.outdoor{font-size:16px;line-height:1.5;display:flex;align-items:flex-start;gap:8px}.outdoor .icon{width:17px;height:24px;color:var(--green)}.access-note{font-size:13px;margin-top:10px}.directory-action{align-self:stretch;display:flex;flex-direction:column;justify-content:center;align-items:stretch;padding:24px 20px 24px 0;gap:12px}.directory-action>p{font-size:14px;line-height:1.5;max-width:25ch}.directory-action .button{font-size:14px;padding-inline:12px}.destination-note{font-size:12px;line-height:1.4}.capacity-mismatch{background:#f5f5f3}.capacity-mismatch .directory-photo{opacity:.65}.directory-help{margin-top:28px;font-size:16px}.directory-card:target{outline:2px solid var(--green);outline-offset:3px}
@media(max-width:1000px){#directory-search{grid-template-columns:1fr 1fr}.directory-card{grid-template-columns:38% minmax(0,1fr)}.directory-photo{grid-row:span 2}.directory-copy{padding:22px 24px 14px}.directory-action{padding:0 24px 22px;gap:8px}.directory-action .button{align-self:flex-start;min-width:190px}.directory-action>p{max-width:none}.selection-heading{align-items:flex-start;flex-direction:column;gap:8px}}
@media(max-width:650px){.directory-intro{padding-top:30px}.directory-intro h1{font-size:36px}.intro-copy{font-size:18px;margin-top:16px}.travel-search{padding:20px 16px;margin-top:26px}.search-heading{align-items:flex-start;flex-direction:column;gap:5px}.search-heading h2{font-size:22px}#directory-search{grid-template-columns:1fr;gap:14px}.search-foot{flex-direction:column;gap:8px}.directory-list{margin-top:34px}.directory-card{grid-template-columns:1fr}.directory-photo{grid-row:auto;min-height:0;height:auto}.directory-photo :global(img){height:auto;aspect-ratio:1.6;object-fit:cover}.directory-copy{padding:20px 20px 14px}.directory-copy h3{font-size:25px}.directory-action{padding:0 20px 20px}.directory-action .button{align-self:stretch}.directory-action>p{font-size:13px}.directory-facts{font-size:15px}.live-results{padding:20px 14px}.selection-heading h2{font-size:23px}.directory-cards{gap:18px}.provider-frame{margin-inline:-14px}.live-results>p{font-size:14px}.live-results .search-note{font-size:13px}}
@media(max-width:360px){.provider-frame{margin-inline:-30px}.provider-frame iframe{zoom:.95}.directory-intro h1{font-size:32px}.directory-copy{padding-inline:16px}.directory-action{padding-inline:16px}}
@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
</style>
