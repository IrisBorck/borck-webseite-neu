---
import Layout from '../../layouts/ApartmentLayout.astro';
import Header from '../../components/ApartmentHeader.astro';
import Footer from '../../components/ApartmentFooter.astro';
import Dialogs from '../../components/ApartmentDialogs.astro';
import Icon from '../../components/Icon.astro';
import images from '../../data/saphir-images.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photos = images.filter(p => p.file.includes('Saphir'));
const maps = images.filter(p => !p.file.includes('Saphir'));
const imgUrl = (file: string) => `${base}/images/saphir/${file}`;
const distances = [['Familienlagune Perlebucht','0,4 km'],['Restaurant','0,4 km'],['Adventure Golf','0,5 km'],['Beach Bar','0,7 km'],['Surfschule','0,8 km'],['Tretboot-Verleih','0,8 km'],['Kurpark','0,8 km'],['Hundestrand','1,3 km'],['Ärztezentrum','1,5 km'],['Supermarkt','1,5 km'],['Fußgängerzone Alleestraße','1,7 km'],['Bahnhof','1,9 km'],['Golfplatz','10,4 km'],['Flugplatz Heide/Büsum','10,4 km'],['Flughafen Hamburg','124,0 km']];
---
<Layout title="Saphir · Terrasse & Gartenblick · Haus Aquamarin Büsum" description="Saphir im Haus Aquamarin: 60 m² im Erdgeschoss, bis zu vier Personen, zwei Schlafzimmer und Terrasse mit Gartenblick. Fotos, Ausstattung und Lage. Testseite ohne Buchungsabschluss.">
<a class="skip-link" href="#inhalt">Zum Hauptinhalt springen</a>
<div class="preview-banner">Neue Website · Vorschau <span>— Buchungen sind hier noch nicht möglich.</span></div>
<Header availabilityHref="#buchung" />
<main id="inhalt">
<section class="detail-top"><div class="container">
<h1>Saphir</h1>
<ul class="key-facts" aria-label="Die wichtigsten Eckdaten"><li><strong>60 m²</strong> Wohnfläche</li><li>bis <strong>4 Personen</strong></li><li><strong>Erdgeschoss</strong></li><li><strong>2 Schlafzimmer</strong></li><li><strong>Terrasse</strong> mit Gartenblick</li></ul>
<div class="photos-calendar">
<section class="gallery" aria-label="Fotos von Saphir" aria-roledescription="Bildergalerie">
<button class="gallery-main" type="button" aria-label="Aktuelles Foto vergrößern" data-gallery-open><img id="gallery-photo" src={imgUrl(photos[0].file)} alt={photos[0].alt} width={photos[0].width} height={photos[0].height} fetchpriority="high" /><span>Foto vergrößern <span aria-hidden="true">↗</span></span></button>
<div class="gallery-controls"><button class="gallery-prev" type="button" aria-label="Vorheriges Foto">←</button><p id="gallery-status" role="status" aria-live="polite" aria-atomic="true">Bild 1 von {photos.length}</p><button class="gallery-next" type="button" aria-label="Nächstes Foto">→</button></div>
<div class="gallery-thumbnails" aria-label="Alle Fotos auswählen">{photos.map((p,i) => <button type="button" data-photo={i} data-src={imgUrl(p.file)} data-alt={p.alt} aria-label={`Bild ${i+1}: ${p.alt}`} aria-pressed={i===0 ? 'true' : 'false'}><img src={imgUrl(p.thumb || p.file)} alt="" width="160" height="110" loading="lazy" /></button>)}</div>
<noscript><p>Alle Bilder in Originalgröße: {photos.map((p,i) => <a href={imgUrl(p.file)}>Bild {i+1} · {p.alt} </a>)}</p></noscript>
</section>
<aside class="calendar-panel" aria-labelledby="calendar-title"><p class="eyebrow">Dein Reisezeitraum</p><h2 id="calendar-title">Belegungskalender</h2>
<p>Die Kalenderanzeige wird direkt von Smoobu geladen. Sie dient ausschließlich zur Ansicht.</p>
<iframe id="saphir-calendar" src={`${base}/calendar/saphir.html`} title="Smoobu-Belegungskalender für Saphir" sandbox="allow-scripts" referrerpolicy="no-referrer" height="420"></iframe>
<p id="calendar-status" class="calendar-note" role="status">Der Kalender wird geladen. Falls keine Anzeige erscheint, ist die Kalenderanbindung in dieser Vorschau nicht verfügbar.</p>
<a class="button" href="#buchung">Preise &amp; Buchung <Icon name="arrow" /></a>
<p class="small-note">Über diese Testseite sind keine Buchungen möglich.</p>
</aside>
</div></div></section>
<section class="section sand equipment" aria-labelledby="equipment-title"><div class="container"><h2 id="equipment-title">Ausstattung</h2>
<div class="equipment-grid">
<section><h3>Wohn- &amp; Essbereich</h3><ul><li>Großzügiger <strong>Wohn- und Essbereich</strong> mit offener Küche</li></ul></section>
<section><h3>Außenbereich &amp; Haus</h3><ul><li><strong>Terrasse mit Sitzgelegenheit</strong></li><li><strong>Gartenmöbel</strong> von April bis Oktober</li><li>Eigener kostenloser <strong>PKW-Stellplatz</strong> direkt am Haus</li><li><strong>Abschließbare Garage</strong> für Fahrräder und Fahrradträger</li><li><strong>Münzwaschmaschine und Münztrockner</strong> zur gemeinschaftlichen Nutzung in einem separaten Raum in der Garage</li></ul></section>
<section><h3>Küche</h3><ul><li>Offene <strong>Einbauküche</strong> im Wohn- und Essbereich</li><li><strong>Induktionskochfeld</strong></li><li><strong>Backofen mit Mikrowellenfunktion</strong></li><li><strong>Geschirrspüler</strong></li><li><strong>Kühlschrank mit Gefrierfach</strong></li><li><strong>Kaffeemaschine, Wasserkocher und Toaster</strong></li></ul></section>
<section><h3>Schlafen</h3><ul><li>Schlafzimmer mit <strong>Doppelbett (180 cm)</strong> und <strong>zwei Matratzen à 90 cm</strong></li><li>Zweites Schlafzimmer mit <strong>Etagenbett (2 Schlafplätze)</strong></li><li><strong>Kopfkissen und Bettdecken</strong> für alle Betten vorhanden</li></ul><p>Bezüge und Handtücher können optional hinzugebucht oder selbst mitgebracht werden.</p></section>
<section><h3>Badezimmer</h3><ul><li>Kleines <strong>Duschbad ohne Fenster</strong></li><li><strong>Haartrockner</strong> vorhanden</li></ul></section>
<section><h3>Unterhaltung &amp; WLAN</h3><ul><li>Kostenloses <strong>WLAN / WiFi</strong></li><li><strong>Flachbild-TV mit SAT-Anschluss</strong></li><li><strong>Grundig Digitalradio (DAB+)</strong></li></ul></section>
</div>
<details class="optional"><summary>Optionale Leistungen <Icon name="chevron" /></summary><div><p>Eigene Bettwäsche und Handtücher kannst du gerne mitbringen. Alternativ stehen diese Leistungen zur Verfügung:</p><dl class="optional-prices"><div><dt><strong>Babybett</strong>, einmalig</dt><dd>5,00 €</dd></div><div><dt><strong>Hochstuhl</strong>, einmalig</dt><dd>5,00 €</dd></div><div><dt><strong>Bett- und Kissenbezüge</strong>, pro Person</dt><dd>12,00 €</dd></div><div><dt><strong>Handtuchpaket</strong> (1 Handtuch + 1 Duschtuch)</dt><dd>9,00 €</dd></div><div><dt><strong>Erster Hund</strong>, pro Aufenthalt</dt><dd>46,00 €</dd></div><div><dt><strong>Zweiter Hund</strong>, pro Aufenthalt</dt><dd>23,00 €</dd></div></dl></div></details>
</div></section>
<section class="section location" aria-labelledby="location-title"><div class="container"><h2 id="location-title">Lage &amp; Entfernungen</h2><p class="location-address"><strong>Haus Aquamarin · Große Tiefe 31 · 25761 Büsum</strong><br />Ruhig gelegen, ca. 350 m vom Deich und ca. 400 m von der Familienlagune Perlebucht entfernt.</p>
<div class="location-grid"><div>{maps.filter(p=>p.file.includes('Familienlagune')).map(p=><img class="location-map" src={imgUrl(p.file)} alt={p.alt} width={p.width} height={p.height} loading="lazy" />)}</div><dl class="distances">{distances.map(([name,distance])=><div><dt>{name}</dt><dd>ca. {distance}</dd></div>)}</dl></div>
<div class="region-grid">{maps.filter(p=>p.file.includes('Lageplan')).map(p=><img class="region-map" src={imgUrl(p.file)} alt={p.alt} width={p.width} height={p.height} loading="lazy" />)}<div><h3>Büsum &amp; die Nordseeküste</h3><p>Haus Aquamarin ist ein Ausgangspunkt für Tage an der Familienlagune Perlebucht und Ausflüge nach Heide, St. Peter-Ording, Tönning, Meldorf, Friedrichskoog und Husum.</p><p>Seehundstation, Helgolandfahrten, Museumshafen, Hundestrand, Phänomania und Wattwanderungen bieten Ziele und Erlebnisse in der Region. Die Familienlagune ist zu Fuß erreichbar.</p><h3>Mit dem PKW</h3><p>Ab Hamburg ca. 1,5 Stunden, je nach Verkehr: über die <strong>A23 Richtung Heide/Holstein</strong>, Abfahrt <strong>Heide-West</strong>, dann über die <strong>B203 nach Büsum</strong>.</p><h3>Mit der Bahn</h3><p>Von <strong>Hamburg Hbf nach Heide</strong>, von dort weiter nach <strong>Büsum</strong>. Die Strecke Heide–Büsum dauert ca. <strong>20 Minuten</strong>.</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Gro%C3%9Fe+Tiefe+31%2C+25761+B%C3%BCsum" target="_blank" rel="noopener noreferrer">Anfahrt in Google Maps öffnen ↗</a></div></div>
</div></section>
<section class="section aqua booking-detail" id="buchung" aria-labelledby="booking-title"><div class="container"><h2 id="booking-title">Verfügbarkeit, Preise &amp; Buchung</h2><div class="booking-columns"><div><p><strong>Die Buchungsfunktion ist in dieser Vorschau noch nicht angebunden.</strong> Hier werden keine aktuellen Aufenthaltspreise berechnet und keine Reservierungen angelegt.</p><p>Für freie Termine und ein Angebot erreichst du Iris persönlich. Die vollständige Preisaufstellung erhältst du mit deinem individuellen Angebot.</p><div class="actions"><a class="button" href="mailto:iris_borck@mac.com?subject=Unverbindliche%20Anfrage%20Apartment%20Saphir">Unverbindlich anfragen <Icon name="arrow" /></a><a class="text-link" href="tel:+491727952082">+49 172 7952082</a></div></div><div><p><strong>Kurzreisezuschlag:</strong> einmalig 85,00 € bei weniger als fünf Übernachtungen.</p><p><strong>Kurabgabe:</strong> fällt zusätzlich nach den jeweils zutreffenden örtlichen Regeln an; sie wird hier noch nicht berechnet.</p><p><strong>Anreise:</strong> ab 15:00 Uhr, auch spät am Abend möglich.<br /><strong>Abreise:</strong> bis 10:00 Uhr.</p></div></div></div></section>
</main>
<Footer /><Dialogs />
<dialog class="gallery-dialog" id="photo-viewer" aria-labelledby="photo-title"><button class="dialog-close" type="button" aria-label="Fotogalerie schließen"><Icon name="close" /></button><h2 id="photo-title" class="sr-only">Fotogalerie</h2><img id="viewer-image" src={imgUrl(photos[0].file)} alt={photos[0].alt} width={photos[0].width} height={photos[0].height} /><div class="viewer-caption"><p id="viewer-description">{photos[0].alt}</p><div class="gallery-controls"><button class="gallery-prev" type="button" aria-label="Vorheriges Foto">←</button><p id="viewer-status" role="status" aria-live="polite" aria-atomic="true">Bild 1 von {photos.length}</p><button class="gallery-next" type="button" aria-label="Nächstes Foto">→</button></div></div></dialog>
<script src="../../scripts/apartment-shell.ts"></script>
<script src="../../scripts/saphir-gallery.ts"></script>
</Layout>
<style>
.detail-top{padding:44px 0 64px}.key-facts{display:flex;flex-wrap:wrap;gap:12px 26px;list-style:none;padding:0;margin:22px 0 34px;font-size:17px}.key-facts li{padding-left:14px;border-left:2px solid var(--green)}.photos-calendar{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:36px;align-items:start}.gallery,.calendar-panel{min-width:0}.gallery-main{display:block;position:relative;width:100%;padding:0;border-radius:20px;overflow:hidden;background:var(--aqua)}.gallery-main img{width:100%;aspect-ratio:4/3;object-fit:cover}.gallery-main>span{position:absolute;bottom:16px;right:16px;border-radius:8px;padding:8px 12px;background:white;font-size:14px;font-weight:600}.gallery-controls{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:10px 0}.gallery-controls button{width:46px;height:44px;border:1px solid var(--line);border-radius:10px;background:white;font-size:22px}.gallery-controls button:hover{background:var(--aqua)}.gallery-controls p{font-size:14px}.gallery-thumbnails{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px}.gallery-thumbnails button{padding:3px;border:2px solid transparent;border-radius:9px;overflow:hidden}.gallery-thumbnails button[aria-pressed=true]{border-color:var(--green)}.gallery-thumbnails img{width:100%;height:auto;aspect-ratio:1.25;object-fit:cover;border-radius:4px}.calendar-panel{padding:28px;background:var(--aqua);border:1px solid var(--line);border-radius:20px}.calendar-panel h2{color:var(--navy);font-size:27px;margin-bottom:16px}.calendar-panel>p{font-size:16px}.calendar-panel iframe{border:0;background:white;border-radius:12px;width:100%;margin-top:22px}.calendar-note{font-size:13px!important;line-height:1.5;margin:12px 0 20px}.calendar-panel .small-note{font-size:13px;margin-top:14px}.equipment h2,.location h2,.booking-detail h2{margin-bottom:28px}.equipment-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.equipment-grid section{background:white;padding:28px;border:1px solid var(--line);border-radius:16px}.equipment-grid h3{font-size:21px}.equipment-grid ul{padding-left:20px;margin:16px 0 0}.equipment-grid li{padding:5px 0}.equipment-grid p{margin-top:16px}.optional{margin-top:26px;background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden}.optional summary{cursor:pointer;display:flex;justify-content:space-between;gap:20px;align-items:center;padding:22px 28px;font:700 20px Manrope,sans-serif;list-style:none}.optional[open] summary .icon{transform:rotate(180deg)}.optional>div{padding:0 28px 26px}.optional-prices{margin-bottom:0;max-width:720px}.optional-prices>div,.distances>div{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding:9px 0}.optional-prices dd,.distances dd{margin:0;white-space:nowrap}.location-address{font-size:18px;margin-bottom:30px}.location-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center}.location-map{width:100%;height:auto;border-radius:16px}.distances{margin:0}.distances>div{padding:7px 0}.region-grid{display:grid;grid-template-columns:1fr 1.2fr;align-items:start;gap:48px;margin-top:60px}.region-map{width:100%;border-radius:16px}.region-grid h3{font-size:21px;margin-bottom:14px}.region-grid p+h3{margin-top:26px}.region-grid a{margin-top:18px}.booking-columns{display:grid;grid-template-columns:1.3fr 1fr;gap:60px}.booking-columns .actions{margin-top:26px}.gallery-dialog{width:min(1100px,94vw);max-width:none;background:var(--navy);color:white;padding:0}.gallery-dialog>img{width:100%;height:min(68vh,760px);object-fit:contain;background:var(--navy)}.viewer-caption{padding:18px 26px}.viewer-caption>p{font-size:16px}.viewer-caption .gallery-controls{max-width:320px;margin:auto}.viewer-caption button{color:var(--navy)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@media(max-width:1000px){.photos-calendar{grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:24px}.calendar-panel{padding:20px}.gallery-thumbnails{grid-template-columns:repeat(5,minmax(0,1fr))}.location-grid,.region-grid{gap:28px}}
@media(max-width:760px){.detail-top{padding:30px 0 44px}.key-facts{font-size:16px;gap:12px 18px}.photos-calendar,.equipment-grid,.location-grid,.region-grid,.booking-columns{grid-template-columns:1fr}.gallery-thumbnails{grid-template-columns:repeat(5,minmax(0,1fr))}.calendar-panel{margin-top:4px}.equipment-grid section{padding:23px}.region-grid{margin-top:36px}.booking-columns{gap:30px}.optional summary{font-size:18px;padding:20px}.optional>div{padding:0 20px 22px}.location-address{font-size:17px}.gallery-dialog>img{height:58vh}.viewer-caption{padding:18px}.gallery-main>span{font-size:12px;bottom:12px;right:12px}.optional-prices>div{gap:12px}}
</style>
