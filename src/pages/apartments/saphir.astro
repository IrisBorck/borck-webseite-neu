---
import Layout from '../../layouts/ApartmentLayout.astro';
import Header from '../../components/ApartmentHeader.astro';
import Footer from '../../components/ApartmentFooter.astro';
import Dialogs from '../../components/ApartmentDialogs.astro';
import Icon from '../../components/Icon.astro';
import images from '../../data/saphir-images.json';
import BookingInformation from '../../components/apartment/BookingInformation.astro';
import VisitorTaxInformation from '../../components/apartment/VisitorTaxInformation.astro';
import VisitorTaxCalculator from '../../components/apartment/VisitorTaxCalculator.astro';
import BookingSection from '../../components/apartment/BookingSection.astro';
import SaphirBookingBar from '../../components/apartment/SaphirBookingBar.astro';
import SaphirExtras from '../../components/apartment/SaphirExtras.astro';
import SaphirPriceSummary from '../../components/apartment/SaphirPriceSummary.astro';
import { apartmentBooking } from '../../data/booking-policy.mjs';
const endpoint = import.meta.env.PUBLIC_AVAILABILITY_URL || '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photos = images.filter(p => p.file.includes('Saphir'));
const maps = images.filter(p => !p.file.includes('Saphir'));
const imgUrl = (file: string) => `${base}/images/saphir/${file}`;
const distances = [['Familienlagune Perlebucht','0,4 km'],['Restaurant','0,4 km'],['Adventure Golf','0,5 km'],['Beach Bar','0,7 km'],['Surfschule','0,8 km'],['Tretboot-Verleih','0,8 km'],['Kurpark','0,8 km'],['Hundestrand','1,3 km'],['Ärztezentrum','1,5 km'],['Supermarkt','1,5 km'],['Fußgängerzone Alleestraße','1,7 km'],['Bahnhof','1,9 km'],['Golfplatz','10,4 km'],['Flugplatz Heide/Büsum','10,4 km'],['Flughafen Hamburg','124,0 km']];
const mainDistances = [['Deich','350 m'],['Familienlagune Perlebucht','400 m'],['Hundestrand','1,3 km'],['Supermarkt','1,5 km'],['Fußgängerzone / Zentrum','1,7 km'],['Bahnhof Büsum','1,9 km']];
const otherDistances = distances.filter(([name]) => !['Familienlagune Perlebucht','Hundestrand','Supermarkt','Fußgängerzone Alleestraße','Bahnhof'].includes(name));
const previewIndexes = [0, 1, 7, 8, 10, 11];
---
<Layout bookingEnabled searchEndpoint={endpoint} title="Saphir · Terrasse & Gartenblick · Haus Aquamarin Büsum" description="Saphir im Haus Aquamarin: 60 m² im Erdgeschoss, bis zu vier Personen, zwei Schlafzimmer und Terrasse mit Gartenblick. Alle Fotos, Ausstattung, Belegungskalender, Kurabgaben-Rechner und direkte Buchung.">
<a class="skip-link" href="#inhalt">Zum Hauptinhalt springen</a>
<div class="preview-banner">Neue Website · Vorschau <span>— Saphir direkt buchen.</span></div>
<Header availabilityHref="#saphir-price-entry" />
<main id="inhalt" class="saphir-detail">
<section class="detail-top"><div class="container">
<h1>Saphir</h1>
<ul class="key-facts" aria-label="Die wichtigsten Eckdaten"><li><strong>60 m²</strong> Wohnfläche</li><li>bis <strong>4 Personen</strong></li><li><strong>Erdgeschoss</strong></li><li><strong>2 Schlafzimmer</strong></li><li><strong>Terrasse</strong> mit Gartenblick</li></ul>
<div class="photos-calendar">
<section class="gallery" aria-label="Fotos von Saphir" aria-roledescription="Bildergalerie">
<button class="gallery-main" type="button" aria-label="Aktuelles Foto vergrößern" aria-describedby="gallery-description" data-gallery-open><img id="gallery-photo" src={imgUrl(photos[0].file)} alt={photos[0].alt} width={photos[0].width} height={photos[0].height} fetchpriority="high" /><span>Foto vergrößern <span aria-hidden="true">↗</span></span></button>
<div class="gallery-controls"><button class="gallery-prev" type="button" aria-label="Vorheriges Foto">←</button><p id="gallery-status" role="status" aria-live="polite" aria-atomic="true"><span data-photo-count>1 / {photos.length}</span><span id="gallery-description" class="sr-only" data-photo-description>{photos[0].alt}</span></p><button class="gallery-next" type="button" aria-label="Nächstes Foto">→</button></div>
<div class="gallery-thumbnails" aria-label="Sechs ausgewählte Fotos">{previewIndexes.map(i => <button type="button" data-photo={i} aria-label={`Bild ${i+1} vergrößern: ${photos[i].alt}`} aria-pressed={i===0 ? 'true' : 'false'}><img src={imgUrl(photos[i].thumb || photos[i].file)} alt="" width="160" height="110" loading="lazy" /></button>)}</div>
<button class="all-photos text-link" type="button" data-gallery-all>Alle {photos.length} Fotos ansehen <span aria-hidden="true">↗</span></button>
<div hidden data-gallery-data>{photos.map(p => <span data-photo-entry data-src={imgUrl(p.file)} data-alt={p.alt} data-width={p.width} data-height={p.height}></span>)}</div>
<noscript><p>Alle Bilder in Originalgröße: {photos.map((p,i) => <a href={imgUrl(p.file)}>Bild {i+1} · {p.alt} </a>)}</p></noscript>
</section>
<aside class="calendar-panel" aria-labelledby="calendar-title"><h2 id="calendar-title">Belegungskalender</h2>
<p>Rot markierte Tage sind belegt.</p>
<iframe id="saphir-calendar" src={`${base}/calendar/saphir.html`} title="Belegungskalender für Saphir" sandbox="allow-scripts" referrerpolicy="no-referrer" height="100"></iframe>
<p id="calendar-status" class="calendar-note" role="status">Der Kalender wird geladen. Falls keine Anzeige erscheint, prüfe deinen Zeitraum bitte im Buchungsformular.</p>


</aside>
</div></div></section>
<SaphirBookingBar endpoint={endpoint} />
<section class="booking-flow" data-booking-flow hidden aria-label="Dein Aufenthalt in Saphir">
<div class="container flow-inner">
<div class="flow-card"><SaphirExtras /></div>
<VisitorTaxCalculator maxPeople={4} />
<div class="flow-card"><SaphirPriceSummary /><BookingSection apartment={apartmentBooking.saphir} compact /></div>
</div>
</section>
<section class="section sand equipment" aria-labelledby="equipment-title"><div class="container"><h2 id="equipment-title">Ausstattung</h2>
<div class="equipment-grid">
<section><h3>Wohn- &amp; Essbereich</h3><ul><li>Großzügiger <strong>Wohn- und Essbereich</strong> mit offener Küche</li></ul></section>
<section><h3>Außenbereich &amp; Haus</h3><ul><li><strong>Terrasse mit Sitzgelegenheit</strong></li><li><strong>Gartenmöbel</strong> von April bis Oktober</li><li>Eigener kostenloser <strong>PKW-Stellplatz</strong> direkt am Haus</li><li><strong>Abschließbare Garage</strong> für Fahrräder und Fahrradträger</li><li><strong>Münzwaschmaschine und Münztrockner</strong> zur gemeinschaftlichen Nutzung in einem separaten Raum in der Garage</li></ul></section>
<section><h3>Küche</h3><ul><li>Offene <strong>Einbauküche</strong> im Wohn- und Essbereich</li><li><strong>Induktionskochfeld</strong></li><li><strong>Backofen mit Mikrowellenfunktion</strong></li><li><strong>Geschirrspüler</strong></li><li><strong>Kühlschrank mit Gefrierfach</strong></li><li><strong>Kaffeemaschine, Wasserkocher und Toaster</strong></li></ul></section>
<section><h3>Schlafen</h3><ul><li>Schlafzimmer mit <strong>Doppelbett (180 cm)</strong> und <strong>zwei Matratzen à 90 cm</strong></li><li>Zweites Schlafzimmer mit <strong>Etagenbett (2 Schlafplätze)</strong></li><li><strong>Kopfkissen und Bettdecken</strong> für alle Betten vorhanden</li></ul><p>Bezüge und Handtücher können optional hinzugebucht oder selbst mitgebracht werden.</p></section>
<section><h3>Badezimmer</h3><ul><li>Kleines <strong>Duschbad</strong></li><li><strong>Haartrockner</strong> vorhanden</li></ul></section>
<section><h3>Unterhaltung &amp; WLAN</h3><ul><li>Kostenloses <strong>WLAN / WiFi</strong></li><li><strong>Flachbild-TV mit SAT-Anschluss</strong></li><li><strong>Grundig Digitalradio (DAB+)</strong></li></ul></section>
</div>
</div></section>
<section class="section" aria-label="Buchungsinformationen und Kurabgabe"><div class="container information-grid"><BookingInformation /><VisitorTaxInformation /></div></section>
<section class="section location" aria-labelledby="location-title"><div class="container"><h2 id="location-title">Lage &amp; Entfernungen</h2><p class="location-address"><strong>Haus Aquamarin · Große Tiefe 31 · 25761 Büsum</strong><br />Ruhig gelegen, nahe Deich und Familienlagune Perlebucht.</p>
<div class="location-grid"><div>{maps.filter(p=>p.file.includes('Familienlagune')).map(p=><img class="location-map" src={imgUrl(p.file)} alt={p.alt} width={p.width} height={p.height} loading="lazy" />)}</div><div><dl class="distances">{mainDistances.map(([name,distance])=><div><dt>{name}</dt><dd>ca. {distance}</dd></div>)}</dl>
<details class="more-distances"><summary>Weitere Entfernungen anzeigen</summary><dl class="distances">{otherDistances.map(([name,distance])=><div><dt>{name}</dt><dd>ca. {distance}</dd></div>)}</dl></details>
<div class="location-links"><a class="text-link" href={`${base}/#lage`}>Mehr zu Lage &amp; Anfahrt <Icon name="arrow" /></a></div></div></div>
</div></section>
</main>
<Footer /><Dialogs bookingEnabled />
<dialog class="gallery-dialog" id="photo-viewer" aria-labelledby="photo-title"><button class="dialog-close" type="button" aria-label="Fotogalerie schließen"><Icon name="close" /></button><h2 id="photo-title" class="sr-only">Fotogalerie</h2><img id="viewer-image" src={imgUrl(photos[0].file)} alt={photos[0].alt} width={photos[0].width} height={photos[0].height} /><div class="viewer-caption"><div class="gallery-controls"><button class="gallery-prev" type="button" aria-label="Vorheriges Foto">←</button><p id="viewer-status" role="status" aria-live="polite" aria-atomic="true"><span data-photo-count>1 / {photos.length}</span><span class="sr-only" data-photo-description>{photos[0].alt}</span></p><button class="gallery-next" type="button" aria-label="Nächstes Foto">→</button></div></div></dialog>
<script src="../../scripts/saphir-gallery.ts"></script>
</Layout>
<style>
.booking-flow{background:var(--aqua);padding-block:28px 36px}.booking-flow[hidden]{display:none}.flow-inner{display:grid;gap:24px}.flow-card{background:white;border:1px solid var(--line);border-radius:20px;padding:24px;min-width:0}.flow-card :global(.optional){margin:0;padding:0;border:0}
@media(max-width:600px){.booking-flow{padding-block:20px 26px}.flow-inner{gap:18px}.flow-card{padding:20px 16px}}

:global(html.saphir-page){scroll-padding-top:var(--saphir-scroll-offset,190px)}
.detail-top{padding:32px 0 30px}.key-facts{display:flex;flex-wrap:wrap;gap:8px 22px;list-style:none;padding:0;margin:18px 0 26px;font-size:16px}.key-facts li{padding-left:12px;border-left:2px solid var(--green)}
.photos-calendar{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:28px;align-items:start}.gallery,.calendar-panel{min-width:0}.gallery-main{display:block;position:relative;width:100%;padding:0;border-radius:14px;overflow:hidden;background:var(--aqua)}.gallery-main img{width:100%;aspect-ratio:1.65;object-fit:cover}.gallery-main>span{position:absolute;bottom:12px;right:12px;border-radius:6px;padding:6px 10px;background:white;font-size:12px;font-weight:600}.gallery-controls{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:6px 0}.gallery-controls button{width:44px;height:44px;border:1px solid var(--line);border-radius:9px;font-size:21px;background:white}.gallery-controls button:hover{background:var(--aqua)}.gallery-controls p{font-size:13px}.gallery-thumbnails{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:5px}.gallery-thumbnails button{padding:2px;border:2px solid transparent;border-radius:7px;overflow:hidden;min-height:44px}.gallery-thumbnails button[aria-pressed=true]{border-color:var(--green)}.gallery-thumbnails img{width:100%;height:auto;aspect-ratio:1.35;object-fit:cover;border-radius:4px}.all-photos{margin-top:5px;min-height:44px;font-size:14px}
.calendar-panel{padding:20px 16px;background:var(--aqua);border:1px solid var(--line);border-radius:14px}.calendar-panel .eyebrow{font-size:10px;margin-bottom:6px}.calendar-panel h2{font-size:25px;color:var(--navy);margin-bottom:8px}.calendar-panel>p{font-size:14px;line-height:1.45}.calendar-panel iframe{display:block;width:100%;border:0;background:white;border-radius:10px;margin-top:14px}.calendar-note{font-size:12px!important;margin:8px 0}.calendar-panel .text-link{font-size:14px;min-height:44px}
.saphir-detail>.section{padding-block:48px}.equipment h2,.location h2{margin-bottom:24px}.equipment-grid{columns:3;column-gap:36px}.equipment-grid section{break-inside:avoid;padding:0 0 22px;margin:0 0 18px;border-bottom:1px solid var(--line)}.equipment-grid h3{font-size:18px;margin-bottom:10px}.equipment-grid ul{padding-left:18px;margin:0;font-size:16px;line-height:1.5}.equipment-grid li{padding:3px 0}.equipment-grid p{font-size:15px;line-height:1.5;margin-top:8px}.equipment-grid strong{font-weight:650}.optional{margin-top:20px;padding-top:22px;border-top:2px solid var(--green)}.optional h3{font-size:20px;margin-bottom:8px}.optional p{font-size:15px;max-width:none}.optional-prices{display:grid;grid-template-columns:1fr 1fr;gap:0 36px;margin:16px 0 0}.optional-prices>div,.distances>div{display:flex;justify-content:space-between;gap:18px;border-bottom:1px solid var(--line);padding:8px 0;font-size:16px}.optional-prices dt{min-width:0}.optional-prices dd,.distances dd{margin:0;white-space:nowrap}.optional-prices strong{font-weight:650}
.information-grid{display:grid;grid-template-columns:1fr;gap:42px;align-items:start}.location-address{font-size:16px;margin-bottom:24px}.location-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:32px;align-items:start}.location-map{width:100%;height:auto;border-radius:14px}.distances{margin:0}.more-distances{margin-top:10px}.more-distances summary{cursor:pointer;min-height:44px;padding:10px 0;font-size:15px;font-weight:600}.location-links{margin-top:16px}.location-links .text-link{min-height:44px;font-size:15px}
.gallery-dialog :focus-visible{outline-color:white}.gallery-dialog{width:min(1100px,94vw);max-width:none;background:var(--navy);color:white;padding:0}.gallery-dialog>img{width:100%;height:min(68vh,760px);object-fit:contain;background:var(--navy)}.viewer-caption{padding:8px 22px 16px}.viewer-caption .gallery-controls{max-width:320px;margin:auto}.viewer-caption button{color:var(--navy)}.gallery-dialog .dialog-close{z-index:1;color:var(--navy)}.gallery-dialog .dialog-close:focus-visible{outline-color:var(--green)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@media(max-width:1100px){.photos-calendar{grid-template-columns:1fr;gap:22px}.gallery{max-width:none}.gallery-main img{aspect-ratio:1.9}.calendar-panel{padding:20px}.equipment-grid{columns:2}.information-grid{gap:28px}.gallery-thumbnails img{aspect-ratio:1.8}}
@media(max-width:760px){.information-grid,.location-grid{grid-template-columns:1fr;gap:28px}.detail-top{padding:26px 0 22px}.key-facts{gap:8px 16px;font-size:15px}.gallery-main img{aspect-ratio:1.45}.gallery-thumbnails{grid-template-columns:repeat(3,minmax(0,1fr))}.gallery-thumbnails img{aspect-ratio:1.8}.calendar-panel{padding:16px 10px}.equipment-grid{columns:1}.equipment-grid section{padding-bottom:18px;margin-bottom:18px}.optional-prices{grid-template-columns:1fr}.saphir-detail>.section{padding-block:34px}.gallery-dialog>img{height:58vh}.viewer-caption{padding:14px}.calendar-panel h2{font-size:23px}.location-address{margin-bottom:20px}}
@media(prefers-reduced-motion:reduce){:global(html.saphir-page){scroll-behavior:auto}}
</style>
