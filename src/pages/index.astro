---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { apartments } from '../data/home';
import faqs from '../data/faqs.json';
import reviews from '../data/reviews.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout>
  <a class="skip-link" href="#inhalt">Zum Hauptinhalt springen</a>
  <div class="preview-banner">Neue Startseite · Vorschau <span>— Buchungen sind hier noch nicht möglich.</span></div>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href={`${base}/`} aria-label="Haus Aquamarin – Startseite"><img src={`${base}/images/logo.png`} width="64" height="64" alt="Historisches Logo von Haus Aquamarin" /><span>Haus Aquamarin<small>AN DER FAMILIENLAGUNE · BÜSUM</small></span></a>
      <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="navigation"><Icon name="menu" /></button>
      <nav id="navigation" aria-label="Hauptnavigation">
        <a href={`${base}/apartments/`}>Apartments</a><a href="#lage">Lage &amp; Anfahrt</a><button class="nav-link" data-open="guide-lagune">Reiseführer</button><a href="#iris">Über mich</a><a href="#kontakt">Kontakt</a>
        <details class="languages"><summary aria-label="Sprache: Deutsch">DE <Icon name="chevron" /></summary><div><strong>Deutsch ✓</strong><span>English · folgt</span><span>Nederlands · folgt</span><span>Dansk · folgt</span></div></details>
        <a class="button header-book" href="#verfuegbarkeit">Verfügbarkeit</a>
        <a class="header-contact" href="tel:+491727952082"><Icon name="phone" /><span>Anrufen</span></a><a class="header-contact" href="https://wa.me/491727952082" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /><span>WhatsApp</span></a>
      </nav>
    </div>
  </header>
  <main id="inhalt">
    <section class="hero" aria-labelledby="hero-title">
      <img src={`${base}/images/hero-panorama.jpg`} width="2048" height="659" alt="Panorama der Familienlagune Perlebucht mit Landseite links und Wasser rechts" class="hero-photo" fetchpriority="high" />
      <div class="container hero-inner"><div class="hero-copy">
        <p class="eyebrow">HAUS AQUAMARIN · BÜSUM</p><h1 id="hero-title">Zeit für Nordseeluft.</h1>
        <p class="hero-lead">Sieben individuelle Ferienapartments in Büsum, <br />ca. 400 m von der Familienlagune Perlebucht entfernt.</p>
        <p>Auch für längere Aufenthalte über mehrere Wochen oder Monate buchbar.</p>
        <div class="actions"><a class="button" href="#verfuegbarkeit">Verfügbarkeit &amp; Preise</a><a class="button secondary" href="#apartments">Apartments ansehen</a></div>
        <!-- Feste Angaben laut Screenshot von Iris vom 21.09.2026; keine automatische Aktualisierung. -->
        <a class="hero-google" href="https://www.google.com/maps?cid=18045129901455022857" target="_blank" rel="noopener noreferrer">
          <span class="hero-rating-stars" aria-hidden="true">★★★★★</span>
          <span>Google · <strong>4,6 von 5 Sternen</strong> bei <strong>48 Rezensionen</strong> ↗</span>
          <small>Stand: 21.09.2026</small>
        </a>
        <div class="hero-badges"><span><Icon name="check" /> Ohne Portalgebühr</span><span><Icon name="check" /> Direktbuchung</span></div>
      </div></div>
    </section>

    <section class="booking-section" id="verfuegbarkeit" aria-labelledby="booking-title">
      <div class="container booking-box">
        <div class="booking-heading"><div><p class="eyebrow">Wann zieht es dich ans Meer?</p><h2 id="booking-title">Deine Auszeit beginnt hier.</h2></div><span class="preview-label">Vorschau · keine Live-Verfügbarkeit</span></div>
        <form id="availability-form">
          <div class="field"><label for="arrival">Anreise</label><input type="date" id="arrival" name="arrival" required /></div>
          <div class="field"><label for="departure">Abreise</label><input type="date" id="departure" name="departure" required /></div>
          <div class="field"><label for="guests">Gäste</label><select id="guests" name="guests"><option value="1">1 Person</option><option value="2" selected>2 Personen</option><option value="3">3 Personen</option><option value="4">4 Personen</option><option value="5">5 Personen</option></select></div>
          <button class="button" type="submit">Auswahl ansehen <Icon name="arrow" /></button>
        </form>
        <div id="booking-result" class="booking-result" role="status" tabindex="-1" hidden></div>
        <noscript><p>Für die interaktive Auswahl bitte JavaScript aktivieren. Alle Apartments findest du direkt darunter.</p></noscript>
      </div>
    </section>

    <section class="section intro" aria-labelledby="welcome-title"><div class="container">
      <div class="section-heading centered"><p class="eyebrow">GUTE GRÜNDE FÜR DEINEN URLAUB</p><h2 id="welcome-title">Einfach ankommen. Mehr genießen.</h2><p>Persönlich, unkompliziert und mit allem, was deinen Urlaub besonders macht.</p></div>
      <div class="benefits">
        <div><Icon name="anchor" /><h3>Direkt buchen</h3><p>Ohne Portalgebühr und ohne Vermittlungsprovision.</p></div>
        <div><Icon name="clock" /><h3>24/7 anreisen</h3><p>Flexible Anreise – auch später am Abend möglich.</p></div>
        <div><Icon name="parking" /><h3>Kostenlos parken</h3><p>Eigener kostenloser Parkplatz direkt am Haus.</p></div>
        <div><Icon name="sun" /><h3>Balkon oder Terrasse</h3><p>Jedes Apartment verfügt über einen Balkon oder eine Terrasse.</p></div>
        <div><Icon name="heart" /><h3>Hunde willkommen</h3><p>Hunde sind herzlich willkommen.</p></div>
      </div></div></section>
    <section class="section sand recommendations" aria-labelledby="recommend-title"><div class="container">
      <div class="recommend-intro"><img src={`${base}/images/haus-aquamarin-aussenansicht.jpeg`} width="1654" height="1115" alt="Außenansicht von Haus Aquamarin mit rotem Dach und Garten" loading="lazy" /><div><p class="eyebrow">SIEBEN WOHNUNGEN · EIN LIEBLINGSPLATZ</p><h2 id="recommend-title">Welche Auszeit passt zu dir?</h2><p>Nicht jede Reise braucht dasselbe Zuhause. Drei schnelle Empfehlungen für den Moment, auf den du dich gerade freust.</p></div></div>
      <div class="recommend-grid">{[
        {id:'tuerkis', label:'FÜR FAMILIEN', name:'Türkis', text:'Platz für bis zu vier Personen in zwei Schlafzimmern.'},
        {id:'topas', label:'FÜR WEITBLICK', name:'Topas', text:'Deich- und Meerblick und Platz für bis zu fünf Personen.'},
        {id:'bernstein', label:'FÜR ZWEI', name:'Bernstein', text:'Ein Rückzugsort für zwei mit eigener Terrasse und Gartenblick.'},
      ].map(a => <article><p class="eyebrow">{a.label}</p><h3>{a.name}</h3><p>{a.text}</p><button class="text-link" data-open={`apartment-${a.id}`}>Apartment ansehen <Icon name="arrow" /></button></article>)}</div>
    </div></section>

    <section class="section sand" id="apartments" aria-labelledby="apartments-title">
      <div class="container">
        <div class="section-heading"><h2 id="apartments-title">Alle Apartments auf einen Blick.</h2></div>
        <div class="filters" role="group" aria-label="Apartments filtern"><button data-filter="alle" aria-pressed="true">Alle Apartments</button><button data-filter="zwei" aria-pressed="false">Bis 2 Personen</button><button data-filter="vier" aria-pressed="false">Bis 4 Personen</button><button data-filter="fuenf" aria-pressed="false">Bis 5 Personen</button><button data-filter="terrasse" aria-pressed="false">Mit Terrasse</button><button data-filter="balkon" aria-pressed="false">Mit Balkon</button></div>
        <p id="filter-status" class="filter-status" role="status">7 Apartments zur Auswahl</p>
        <div class="apartment-grid">
          {apartments.map(a => <article class="apartment-card" data-apartment={a.id} data-guests={a.guests} data-type={a.type}>
            <div class="card-photo"><Photo stem={a.image} alt={`Wohnbereich im Apartment ${a.name}`} /><span class="photo-tag">{a.floor}</span></div>
            <div class="card-copy"><h3>{a.name}</h3><p class="card-subline"><strong>{a.lead}</strong> – {a.line}</p><ul class="feature-capsules" aria-label={`Merkmale von ${a.name}`}><li>{a.size}</li><li>bis {a.guests} Pers.</li><li>{a.outdoorLabel}</li><li>{a.sleeping}</li></ul><button class="button" data-open={`apartment-${a.id}`}>Apartment ansehen <Icon name="arrow" /></button></div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="section host" id="iris" aria-labelledby="host-title"><div class="container split"><Photo stem="iris-mia" alt="Iris mit ihrer Hündin Mia" class="host-photo" /><div><h2 id="host-title">Moin, ich bin Iris.</h2><p class="lead">„Du sollst nicht nur ankommen. Du sollst dich vom ersten Moment an willkommen fühlen.“</p><p>Von der ersten Frage bis zum Ende deines Urlaubs bin ich deine feste Ansprechpartnerin – direkt und ohne Umwege.</p><div class="actions"><button class="text-link" data-open="host-info">Iris kennenlernen <Icon name="arrow" /></button><a class="text-link" href="tel:+491727952082">Iris anrufen <Icon name="arrow" /></a></div></div></div></section>

    <section class="section aqua" id="lage" aria-labelledby="location-title"><div class="container split location-layout">
      <figure class="location-photo"><Photo stem="topas-sea-view" alt="Grüner Deich mit der Nordsee am Horizont, aufgenommen aus Topas" /><figcaption>Deich- und Meerblick aus Topas. Die Ausblicke unterscheiden sich je Apartment.</figcaption></figure>
      <div><p class="eyebrow">HAUS AQUAMARIN · GROSSE TIEFE 31 · BÜSUM</p><h2 id="location-title">Ein kleiner Weg.<br />Ein großes Durchatmen.</h2><p>Der Deich liegt ganz nah, die Familienlagune Perlebucht gleich dahinter. Für einen Spaziergang, einen Tag am Wasser oder einfach einen Moment mit weitem Blick.</p><dl class="distance-list"><div><dt>Zum Deich</dt><dd>ca. 350 m</dd></div><div><dt>Zur Familienlagune</dt><dd>ca. 400 m</dd></div><div><dt>Zum Zentrum / Hafen zu Fuß</dt><dd>ca. 1,7 km</dd></div></dl><button class="text-link" data-open="arrival-info">Deine Anreise planen <Icon name="arrow" /></button></div>
    </div></section>

    <section class="section reviews" id="bewertungen" aria-labelledby="reviews-title"><div class="container"><div class="section-heading centered"><p class="eyebrow">WAS NACH DEM URLAUB BLEIBT</p><h2 id="reviews-title">Am schönsten sagen es die Gäste.</h2><p>Persönliche Begegnungen und kleine Lieblingsmomente.</p></div>
      <div class="review-grid">{reviews.slice(0,6).map(r => <figure class="review-card"><span class="stars" aria-label={`${r.rating} von 5 Sternen`}>{"★".repeat(r.rating)}</span><blockquote>{r.excerpt || r.text}</blockquote>{r.excerpt && <details><summary>Mehr lesen</summary><p>{r.text}</p></details>}<figcaption><strong>{r.name}</strong><span>{r.source}</span></figcaption></figure>)}</div>
      <details class="more-reviews"><summary class="text-link">Weitere Bewertungen anzeigen</summary><div class="review-grid">{reviews.slice(6).map(r => <figure class="review-card"><span class="stars" aria-label={`${r.rating} von 5 Sternen`}>{"★".repeat(r.rating)}</span><blockquote>{r.excerpt || r.text}</blockquote>{r.excerpt && <details><summary>Mehr lesen</summary><p>{r.text}</p></details>}<figcaption><strong>{r.name}</strong><span>{r.source}</span></figcaption></figure>)}</div></details>
      <p class="review-source"><a class="text-link" href="https://www.google.com/maps?cid=18045129901455022857" target="_blank" rel="noopener noreferrer">Bewertungen bei Google lesen ↗</a></p>
    </div></section>

    <section class="section aqua" id="fragen" aria-labelledby="faq-title"><div class="container faq-layout"><div><p class="eyebrow">Gut zu wissen</p><h2 id="faq-title">Noch eine Frage<br />im Gepäck?</h2><p>Die wichtigsten Antworten für deine Planung. Und wenn etwas fehlt, frag mich einfach persönlich.</p><a class="text-link" href="mailto:iris_borck@mac.com">Kontakt mit Iris <Icon name="arrow" /></a></div><div class="faq-list">{faqs.map(f => <details><summary>{f.name}<Icon name="chevron" /></summary><div class="faq-answer" set:html={f.acceptedAnswer.text} />{f.name === "Können wir als Reisegruppe buchen?" && <p class="small-note">Zur Freigabe: Die Angabe zu Etagenbetten und Schlafplätzen wird noch abgeglichen.</p>}{f.name === "Wie und wann muss ich bezahlen?" && <p class="small-note">Testseite: Hier sind keine Buchungen oder Zahlungen möglich. Die Kreditkartenzahlung ist für die spätere, noch zu prüfende Buchungsanbindung vorgesehen.</p>}</details>)}</div></div></section>

    <section class="final-cta" id="abschluss"><div class="container"><h2>Bereit für Büsum?</h2><p>Prüf jetzt die Verfügbarkeit. Du buchst direkt bei Iris.</p><a class="button" href="#verfuegbarkeit">Verfügbarkeit prüfen <Icon name="arrow" /></a></div></section>
  </main>
  <footer id="footer"><div class="container footer-main">
    <div class="footer-brand"><img src={`${base}/images/logo.png`} width="88" height="88" alt="Haus Aquamarin Original-Logo" /><div><strong>Haus Aquamarin</strong><p>Sieben individuelle Ferienapartments in Büsum, nahe der Familienlagune Perlebucht.</p></div></div>
    <div><h3>Navigation</h3><a href={`${base}/apartments/`}>Apartments</a><a href="#lage">Lage &amp; Anfahrt</a><button data-open="guide-lagune">Reiseführer</button><a href="#iris">Über mich</a><a href="#kontakt">Kontakt</a></div>
    <div id="kontakt"><h3>Kontakt</h3><a href="tel:+491727952082">Telefon: +49 172 7952082</a><a href="https://wa.me/491727952082" target="_blank" rel="noopener noreferrer">WhatsApp: +49 172 7952082</a><a href="mailto:iris_borck@mac.com">iris_borck@mac.com</a><p>Große Tiefe 31<br />25761 Büsum</p></div>
    <div><h3>Rechtliches</h3><button data-open="legal-info">Impressum</button><button data-open="privacy-info">Datenschutz</button><button data-open="terms-info">AGB</button></div>
  </div><div class="footer-bottom"><div class="container"><span>© {new Date().getFullYear()} Haus Aquamarin · Website-Vorschau</span></div></div></footer>
  <aside class="mobile-booking" aria-label="Schnell zur Verfügbarkeit" hidden><span>Deine Nordsee-Auszeit<small>Haus Aquamarin</small></span><a class="button" href="#verfuegbarkeit">Verfügbarkeit <Icon name="arrow" /></a></aside>

  {apartments.map(a => <dialog id={`apartment-${a.id}`} aria-labelledby={`title-${a.id}`}><button class="dialog-close" aria-label="Schließen"><Icon name="close" /></button><Photo stem={a.image} alt={`Wohnbereich ${a.name}`} /><div class="dialog-copy"><p class="eyebrow">Dein Apartment im Haus Aquamarin</p><h2 id={`title-${a.id}`}>{a.name}</h2><p>{a.size} · bis {a.guests} Personen · {a.floor}</p><p>{a.note}</p><p><strong>{a.outdoor}</strong></p><a class="button dialog-book" href="#verfuegbarkeit" data-select={a.name}>Reisezeitraum auswählen <Icon name="arrow" /></a><p class="small-note">Apartment-Kurzansicht. Die vollständige Detailseite folgt später.</p></div></dialog>)}
  <dialog id="host-info" aria-labelledby="host-info-title"><button class="dialog-close" aria-label="Schließen"><Icon name="close" /></button><div class="dialog-copy"><h2 id="host-info-title">Moin, ich bin Iris.</h2><p>Die ausführliche Seite „Über mich“ folgt in einem späteren Schritt. Du erreichst mich persönlich unter <a href="tel:+491727952082">0172 7952082</a>.</p></div></dialog>
  <dialog id="arrival-info" aria-labelledby="arrival-title"><button class="dialog-close" aria-label="Schließen"><Icon name="close" /></button><div class="dialog-copy"><p class="eyebrow">Deine Anreise</p><h2 id="arrival-title">Auf nach Büsum.</h2><p><strong>Haus Aquamarin · Große Tiefe 31 · 25761 Büsum</strong></p><p>Mit dem Auto ab Hamburg etwa 1,5 Stunden, je nach Verkehr. Mit der Bahn etwa zwei Stunden. Ein Pkw-Stellplatz und eine abschließbare Fahrradgarage gehören zur Ausstattung.</p><p>Anreise ab 15 Uhr, Abreise bis 10 Uhr. Die genauen Anreiseinformationen erhältst du von Iris.</p></div></dialog>
  <dialog id="guide-lagune" aria-labelledby="lagune-title"><button class="dialog-close" aria-label="Schließen"><Icon name="close" /></button><div class="dialog-copy"><p class="eyebrow">Büsum planen & erleben</p><h2 id="lagune-title">Deine Zeit an der Perlebucht.</h2><p>Vom Haus Aquamarin sind es etwa 400 m zur Familienlagune. Ob Spaziergang am Deich oder ein Tag am Wasser: Du kannst direkt vom Haus aus losgehen.</p><p>Der ausführliche Reiseführer mit persönlichen Tipps, geprüften Informationen und passenden Angeboten wird später ergänzt.</p></div></dialog>
  <dialog id="guide-bike" aria-labelledby="bike-title"><button class="dialog-close" aria-label="Schließen"><Icon name="close" /></button><div class="dialog-copy"><p class="eyebrow">Büsum planen & erleben</p><h2 id="bike-title">Büsum auf zwei Rädern.</h2><p>Für mitgebrachte Fahrräder gibt es eine abschließbare Fahrradgarage. Persönliche Routentipps und direkte Links zu ausgewählten Fahrradvermietern sind für den Reiseführer vorgesehen.</p><p>Eine Fahrradreservierung ist in dieser Startseiten-Vorschau noch nicht möglich.</p></div></dialog>
  <dialog id="guide-trip" aria-labelledby="trip-title"><button class="dialog-close" aria-label="Schließen"><Icon name="close" /></button><div class="dialog-copy"><p class="eyebrow">Büsum planen & erleben</p><h2 id="trip-title">Neue Horizonte entdecken.</h2><p>Helgolandfahrten und weitere Ausflüge sollen hier künftig mit geprüften Informationen und möglichst direkten Buchungswegen zu den Anbietern vorgestellt werden.</p><p>Die Auswahl der Partner und die Buchungsanbindung sind noch offen. In dieser Vorschau werden keine Ausflüge verkauft.</p></div></dialog>
  <dialog id="legal-info" aria-labelledby="legal-title"><button class="dialog-close" aria-label="Schließen"><Icon name="close" /></button><div class="dialog-copy"><h2 id="legal-title">Impressum der Vorschau</h2><p>Iris Borck-Martin<br />Rehdamm 2<br />25746 Heide · Deutschland</p><p>Telefon: +49 172 7952082<br /><a href="mailto:iris_borck@mac.com">iris_borck@mac.com</a><br />USt-IdNr.: DE340109304</p><p>Diese eigenständige Arbeitsversion dient der Beurteilung der neuen Startseite. Sie bietet keinen Buchungsabschluss an.</p></div></dialog>
  <dialog id="privacy-info" aria-labelledby="privacy-title"><button class="dialog-close" aria-label="Schließen"><Icon name="close" /></button><div class="dialog-copy"><h2 id="privacy-title">Datenschutz in der Vorschau</h2><p>Verantwortlich: Iris Borck-Martin, Rehdamm 2, 25746 Heide, iris_borck@mac.com.</p><p>Diese Vorschau nutzt keine Analysewerkzeuge, keine Werbe-Cookies und keine eingebetteten Buchungs- oder Kartendienste. Bilder und Schriften werden mit der Seite ausgeliefert. Deine Datumsauswahl bleibt im Browser und wird nicht versendet oder dauerhaft gespeichert.</p><p>Bei Bereitstellung über GitHub Pages verarbeitet GitHub technische Verbindungsdaten wie die IP-Adresse. Beim Öffnen eines externen Links oder einer E-Mail gilt zusätzlich die Datenverarbeitung des jeweiligen Dienstes.</p><p>Die vollständigen Datenschutzhinweise werden vor einem regulären Websitebetrieb gesondert geprüft und ergänzt.</p></div></dialog>
  <dialog id="terms-info" aria-labelledby="terms-title"><button class="dialog-close" aria-label="Schließen"><Icon name="close" /></button><div class="dialog-copy"><h2 id="terms-title">Buchungsbedingungen</h2><p>Über diese Vorschau können keine verbindlichen Buchungen abgeschlossen werden. Die endgültigen Buchungsbedingungen und die technische Preisberechnung werden vor Freischaltung des Buchungsbereichs separat abgestimmt.</p><p>Bereits festgelegt: Restzahlung 30 Tage vor Anreise, bei kurzfristiger Buchung innerhalb von 30 Tagen sofort. Die Kurabgabe wird separat abgerechnet.</p></div></dialog>
  <script src="../scripts/home.ts"></script>
</Layout>

<style>
  .hero-google { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; width: fit-content; max-width: 100%; }
  .hero-rating-stars { font-size: 21px; line-height: 1; white-space: nowrap; background: linear-gradient(to right, #c9a24b 92%, rgba(255,255,255,.45) 92%); background-clip: text; -webkit-background-clip: text; color: transparent; }
  .hero-google small { flex-basis: 100%; font-size: 12px; }
  @media (forced-colors: active) { .hero-rating-stars { background: none; color: LinkText; } }
</style>
