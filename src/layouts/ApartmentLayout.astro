---
import '../styles/global.css';
const { title = 'Haus Aquamarin · Deine Auszeit in Büsum', description = 'Apartments im Haus Aquamarin in Büsum. Unabhängige Website-Vorschau.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'" />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e375a" />
    <link rel="icon" type="image/png" href={`${base}/images/logo.png`} />
    <link rel="preload" href={`${base}/fonts/manrope.woff2`} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
