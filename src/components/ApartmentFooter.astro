---
import Icon from "./Icon.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { availabilityHref = `${base}/#verfuegbarkeit` } = Astro.props;
---
  <footer id="footer"><div class="container footer-main">
    <div class="footer-brand"><img src={`${base}/images/logo.png`} width="88" height="88" alt="Haus Aquamarin Original-Logo" /><div><strong>Haus Aquamarin</strong><p>Sieben individuelle Ferienapartments in Büsum, nahe der Familienlagune Perlebucht.</p></div></div>
    <div><h3>Navigation</h3><a href={`${base}/apartments/`}>Apartments</a><a href={`${base}/#lage`}>Lage &amp; Anfahrt</a><button data-open="guide-lagune">Reiseführer</button><a href={`${base}/#iris`}>Über mich</a><a href="#kontakt">Kontakt</a></div>
    <div id="kontakt"><h3>Kontakt</h3><a href="tel:+491727952082">Telefon: +49 172 7952082</a><a href="https://wa.me/491727952082" target="_blank" rel="noopener noreferrer">WhatsApp: +49 172 7952082</a><a href="mailto:iris_borck@mac.com">iris_borck@mac.com</a><p>Große Tiefe 31<br />25761 Büsum</p></div>
    <div><h3>Rechtliches</h3><button data-open="legal-info">Impressum</button><button data-open="privacy-info">Datenschutz</button><button data-open="terms-info">AGB</button></div>
  </div><div class="footer-bottom"><div class="container"><span>© {new Date().getFullYear()} Haus Aquamarin · Website-Vorschau</span><div><button data-open="legal-info">Impressum</button><button data-open="privacy-info">Datenschutz</button><button data-open="terms-info">AGB</button></div></div></div></footer>
