---
import Icon from '../Icon.astro';
const { endpoint = '' } = Astro.props;
---
<section class="container primary-travel" id="saphir-price-entry" aria-labelledby="saphir-travel-title">
<div class="travel-box">
<h2 id="saphir-travel-title">Preis &amp; Verfügbarkeit</h2>
<form id="saphir-travel-form">
<div class="travel-fields">
<label>Anreise<input name="arrival" type="date" required /></label>
<label>Abreise<input name="departure" type="date" required /></label>
<label>Erwachsene ab 16 Jahren<select name="adults16" required><option value="">Bitte wählen</option>{[0,1,2,3,4].map(n=><option value={n}>{n}</option>)}</select></label>
<label>Kinder bis einschließlich 15 Jahre<select name="children15" required><option value="">Bitte wählen</option>{[0,1,2,3,4].map(n=><option value={n}>{n}</option>)}</select></label>
</div>
<p class="group-note" data-group-note>Bitte gib deine Reisegruppe an – insgesamt bis zu vier Personen.</p>
<div class="search-footer"><p>Deine Reisedaten werden automatisch für Preisprüfung, Kurabgabe und Buchung übernommen.</p><button type="submit" class="button">Preise &amp; Verfügbarkeit prüfen <Icon name="arrow" /></button></div>
<p data-primary-status role="status" class="primary-status">Wähle deinen Reisezeitraum und deine Reisegruppe.</p>
</form>
</div>
</section>
<div class="saphir-booking-bar" data-saphir-booking data-endpoint={endpoint} aria-label="Preis und Verfügbarkeit für Saphir">
<div class="container bar-inner">
<div class="bar-heading"><strong>Preis &amp; Verfügbarkeit</strong><span>Saphir · bis 4 Personen</span></div>
<button class="travel-edit" type="button" data-edit-travel><Icon name="calendar" /><span data-travel-summary>Reisedaten wählen</span><span class="edit-word">Ändern</span></button>
<div class="bar-price" role="status" aria-live="polite"><strong data-stay-price>Deine Auszeit</strong><span data-stay-status>Wähle deinen Reisezeitraum.</span></div>
<button type="button" class="button" data-book-saphir>Preis prüfen</button>
</div>
</div>
<noscript><p class="container">Für die Preisprüfung benötigst du JavaScript. Iris hilft dir unter <a href="tel:+491727952082">0172 7952082</a>.</p></noscript>
<script src="../../scripts/saphir-booking.ts"></script>
<style>
.primary-travel{padding-block:0 28px}.travel-box{background:var(--aqua);border:1px solid var(--green);border-radius:18px;padding:26px 28px;box-shadow:0 8px 28px rgba(30,55,90,.04)}h2{font-size:24px;color:var(--navy);margin-bottom:20px}.travel-fields{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;align-items:end}.travel-fields label{display:flex;flex-direction:column;gap:8px;min-width:0;font-size:15px;font-weight:600}.travel-fields input,.travel-fields select{appearance:none;width:100%;min-width:0;max-width:100%;height:52px;padding:10px;border:1px solid var(--line);border-radius:8px;background:white;color:var(--navy);font-size:16px}.travel-fields select{appearance:auto}.group-note,.primary-status{font-size:14px;margin-top:14px}.search-footer{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:18px}.search-footer p{font-size:14px;max-width:55ch}.search-footer .button{font-size:14px;flex-shrink:0}.primary-status{border-top:1px solid var(--line);padding-top:14px}
.saphir-booking-bar{position:sticky;top:var(--saphir-header-height,83px);z-index:40;background:rgba(255,255,255,.98);border-block:1px solid var(--line);box-shadow:0 8px 20px rgba(30,55,90,.04)}.bar-inner{display:flex;align-items:center;gap:24px;padding-block:12px}.bar-heading{flex-shrink:0}.bar-heading strong{display:block;font:700 16px Manrope,sans-serif}.bar-heading span,.bar-price span{display:block;font-size:13px;line-height:1.4}.travel-edit{display:flex;align-items:center;gap:10px;min-height:44px;text-align:left;font-size:14px;line-height:1.4;min-width:0}.travel-edit>span{overflow-wrap:anywhere}.edit-word{font-size:12px;text-decoration:underline}.bar-price{margin-left:auto;max-width:250px;min-width:0}.bar-price strong{font:800 18px Manrope,sans-serif;display:block;overflow-wrap:anywhere}.bar-inner>.button{flex-shrink:0;font-size:14px}
@media(max-width:1050px){.bar-heading{display:none}.bar-inner{gap:16px}.travel-fields{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.travel-box{padding:20px 16px}h2{font-size:22px}.search-footer{flex-direction:column;align-items:stretch;gap:14px}.search-footer .button{white-space:normal}.bar-inner{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;padding-block:8px}.travel-edit{grid-column:1/-1;min-height:44px;font-size:12px;padding:0}.travel-edit .icon{width:17px;height:17px}.edit-word{margin-left:auto}.bar-price{margin-left:0;max-width:none}.bar-price strong{font-size:16px}.bar-price span{font-size:12px}.bar-inner>.button{font-size:12px;min-height:44px;padding:8px 12px}}
@media(max-width:480px){.travel-fields{grid-template-columns:1fr}}
@media(max-height:550px){.saphir-booking-bar{position:static}}
</style>
